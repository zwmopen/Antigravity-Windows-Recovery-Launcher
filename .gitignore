# 唯一可整体删除的人工临时工作区
/.work/*
!/.work/README.md

# 可重建构建产物
/build/
/dist/
/out/
/coverage/

# 依赖和缓存
/node_modules/
/.venv/
/venv/
/__pycache__/
*.py[cod]
*.cache
*.tmp
*.log

# 密钥与本地配置
.env
.env.*
!.env.example
config/local.*
secrets/

# 最终安装包默认不进 Git，但保留发布说明和清单
/releases/*
!/releases/README.md
!/releases/manifest.json

.DS_Store
Thumbs.db
